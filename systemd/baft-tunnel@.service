[Unit]
Description=BAFT-TUNNEL authenticated TCP tunnel instance %i
Documentation=https://github.com/zarkmakerburg/BAFT-TUNNEL
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/baft-tunnel/%i.json
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=baft-tunnel
Group=baft-tunnel
WorkingDirectory=/etc/baft-tunnel
ExecStartPre=/usr/local/bin/baft-tunnel config validate --config /etc/baft-tunnel/%i.json
ExecStart=/usr/local/bin/baft-tunnel apply --config /etc/baft-tunnel/%i.json --confirm
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

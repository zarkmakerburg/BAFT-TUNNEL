[Unit]
Description=BAFT-TUNNEL root manage socket for instance %i (ADR-0055)

[Socket]
ListenStream=/run/baft-tunnel/manage/%i.manage.sock
SocketUser=root
SocketGroup=baft-tunnel-agent
SocketMode=0660
DirectoryMode=0755
Accept=no
FileDescriptorName=manage
Service=baft-tunnel-control-manage@%i.service

[Install]
WantedBy=sockets.target

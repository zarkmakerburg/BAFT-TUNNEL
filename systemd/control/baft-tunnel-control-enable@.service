[Unit]
Description=Run the requested enable --now for baft-tunnel@%i (root helper, fixed command)

[Service]
Type=oneshot
# Only this fixed command can run (ADR-0023 amendment); the instance name comes from the request file
# name and the only unit it can reach is baft-tunnel@%i.service (which needs /etc/baft-tunnel/%i.json).
ExecStart=/usr/bin/systemctl --no-block enable --now baft-tunnel@%i.service
ExecStartPost=/usr/bin/rm -f /run/baft-tunnel/control/%i.enable
ExecStopPost=/usr/bin/rm -f /run/baft-tunnel/control/%i.enable
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

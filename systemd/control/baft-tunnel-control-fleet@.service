[Unit]
Description=Fleet identity and control helper for baft-tunnel-agent@%i (root Fleet helper, ADR-0051)
StartLimitIntervalSec=10s
StartLimitBurst=60

[Service]
Type=oneshot
# Fixed command, one bounded Fleet helper operation. It may sign a fleet-node CSR, provision the
# per-instance Hub identity, or queue that Agent instance restart. No network; private keys stay root-only.
ExecStart=/usr/local/bin/baft-tunnel fleet helper --instance %i
ExecStopPost=/usr/bin/rm -f /run/baft-tunnel/control/%i.fleet
TimeoutStartSec=60s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/etc/baft-tunnel -/var/lib/baft-tunnel -/var/lib/baft-tunnel-control /run/baft-tunnel/control -/etc/systemd/system/baft-tunnel-agent@%i.service.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE

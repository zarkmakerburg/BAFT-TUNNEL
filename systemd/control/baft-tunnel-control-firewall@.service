[Unit]
Description=Read the firewall for the tunnel port of baft-tunnel@%i (root helper, read-only, ADR-0030)
StartLimitIntervalSec=10s
StartLimitBurst=60

[Service]
Type=oneshot
# One fixed command. It reads one TCP port from the request file, runs only `nft list ruleset`
# (else `iptables-save`), and writes a small classification (no rule text, no addresses) to
# /run/baft-tunnel/firewall/%i.json. It never changes a rule. CAP_NET_ADMIN is held by this root
# helper alone (kernel requirement for listing), never by the agent or the tunnel.
ExecStart=/usr/local/bin/baft-tunnel firewall-read-helper --instance %i
ExecStopPost=/usr/bin/rm -f /run/baft-tunnel/control/%i.firewall
TimeoutStartSec=15s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/run/baft-tunnel/control -/run/baft-tunnel/firewall
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

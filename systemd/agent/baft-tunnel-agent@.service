[Unit]
Description=BAFT-TUNNEL local agent and panel for instance %i (loopback only)
Documentation=https://github.com/zarkmakerburg/BAFT-TUNNEL
After=network-online.target
Wants=network-online.target
# The agent reports on and controls exactly baft-tunnel@%i; it needs that instance's configuration.
ConditionPathExists=/etc/baft-tunnel/%i.json
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
# Its own user (SA-09): a compromised tunnel process (user baft-tunnel) cannot read the agent token
# or drive the agent. Group baft-tunnel lets the agent read the instance configuration and the
# unit's session/counter files, and drop start/stop requests for the control helper (ADR-0023).
User=baft-tunnel-agent
Group=baft-tunnel-agent
SupplementaryGroups=baft-tunnel
# Token at /var/lib/baft-tunnel-agent/token (created by install-agent-control.sh, mode 0600);
# receipts, desired state, diagnostics and audit log per instance below it.
StateDirectory=baft-tunnel-agent baft-tunnel-agent/%i
StateDirectoryMode=0700
WorkingDirectory=/var/lib/baft-tunnel-agent
Environment=BAFT_AGENT_LISTEN=127.0.0.1:18080
ExecStart=/usr/local/bin/baft-tunnel agent --config /etc/baft-tunnel/%i.json --token-file /var/lib/baft-tunnel-agent/token --state-dir /var/lib/baft-tunnel-agent/%i --instance %i --listen ${BAFT_AGENT_LISTEN}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077
LimitNOFILE=1024
TasksMax=64
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Only the control request directory is writable besides the state directory. /etc/baft-tunnel
# stays read-only: setup init/join are run by root (the panel prints the commands).
ReadWritePaths=-/run/baft-tunnel/control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# AF_UNIX for systemctl show (D-Bus); AF_INET/AF_INET6 for the loopback API and peer probes.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

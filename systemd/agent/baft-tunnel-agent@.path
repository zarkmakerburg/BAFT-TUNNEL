[Unit]
Description=Start the BAFT-TUNNEL agent for instance %i once its configuration exists

[Path]
# The agent normally runs from registration on (setup mode first); this path unit only brings it
# back when /etc/baft-tunnel/%i.json exists and the agent is not running.
PathExists=/etc/baft-tunnel/%i.json
Unit=baft-tunnel-agent@%i.service

[Install]
WantedBy=multi-user.target

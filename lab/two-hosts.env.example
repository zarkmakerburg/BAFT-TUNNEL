# BAFT-TUNNEL two-host LAB inventory template
# Actual host addresses and SSH usernames belong in the GitHub Actions
# environment "baft-tunnel-lab" variables, not in this tracked example.
# Never put passwords, private keys, tokens, or TLS private keys here.

LAB_IRAN_HOST=REPLACE_WITH_IRAN_SERVER_IP
LAB_IRAN_SSH_PORT=22
LAB_IRAN_SSH_USER=root

LAB_ABROAD_HOST=REPLACE_WITH_ABROAD_SERVER_IP
LAB_ABROAD_SSH_PORT=22
LAB_ABROAD_SSH_USER=root

LAB_TEST_PORTS=443,8443,2053,18300

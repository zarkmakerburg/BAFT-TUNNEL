# BAFT-TUNNEL two-host LAB inventory
# Fill only public/reachable host addressing and SSH login metadata here.
# Do NOT put passwords, private keys, tokens, or TLS private keys in this file.
# Keep actual credentials in GitHub Actions -> Settings -> Secrets and variables -> Actions.

# Host 1 — Iran
LAB_IRAN_HOST=CHANGE_ME
LAB_IRAN_SSH_PORT=22
LAB_IRAN_SSH_USER=root

# Host 2 — outside Iran
LAB_ABROAD_HOST=CHANGE_ME
LAB_ABROAD_SSH_PORT=22
LAB_ABROAD_SSH_USER=root

# Optional labels for test reports
LAB_IRAN_LABEL=iran
LAB_ABROAD_LABEL=abroad

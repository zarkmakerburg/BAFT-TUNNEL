# Copy to .env (ignored by git) and fill with TEST-host values only.
# Never put private key contents here; use a protected local file path.
IR_1_HOST=
IR_2_HOST=
EX_1_HOST=
EX_2_HOST=
EX_3_HOST=
EX_4_HOST=
SSH_USER=bafttunnel-lab
SSH_PORT=22
SSH_KEY_FILE=/absolute/path/to/dedicated/baft-tunnel-lab-key
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/verified/baft-tunnel-known_hosts
LAB_TEST_PORTS=443,8443,2053,18300
CONNECT_TIMEOUT=5

# With LAB_PANEL_PAIRING=1, choose noise-tcp or tcp-tls for the two-host panel flow.
LAB_PANEL_ENGINE=noise-tcp
